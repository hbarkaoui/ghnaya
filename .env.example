DATABASE_URL=postgres://ghanni:ghanni@localhost:5433/ghanni
DATABASE_URL_TEST=postgres://ghanni:ghanni@localhost:5433/ghanni_test

# Limites par IP : nombre de proxies de confiance qui ajoutent leur adresse à x-forwarded-for (image Docker
# derrière nginx : 1). Vide sur Vercel, dont le proxy réécrit l'en-tête. Voir README, « Image Docker ».
TRUSTED_PROXY_HOPS=

# Comptes (plan 2). Secret : openssl rand -base64 32
BETTER_AUTH_SECRET=remplacer-par-un-secret-de-32-caracteres-au-moins
BETTER_AUTH_URL=http://localhost:3000
# Google : facultatif en développement (le bouton est masqué sans ces deux valeurs).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# E-mails : boîte locale (.outbox/) hors production ; en production, SMTP.
# MAIL_TRANSPORT=outbox
SMTP_URL=
MAIL_FROM="Ghnaya <connexion@exemple.com>"

# Translittération (plan 4). Sans clé : générateur factice hors production, « indisponible » en production.
ANTHROPIC_API_KEY=
# anthropic | fake | none ; vide : anthropic si ANTHROPIC_API_KEY est là.
TRANSLIT_PROVIDER=
# Vide : claude-opus-5-5.
TRANSLIT_MODEL=
# Générations par jour (UTC) pour toute la plateforme ; vide : 300.
TRANSLIT_DAILY_LIMIT=
