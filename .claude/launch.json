{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev",
        "--port",
        "3000"
      ],
      "port": 3000
    },
    {
      "name": "dev-https",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev:https"
      ],
      "port": 3000,
      "url": "https://localhost:3000"
    }
  ]
}
